{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All C Files",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${workspaceFolder}/Code/*.c",
                "-I${workspaceFolder}/HeadFiles",
                "-o",
                "${workspaceFolder}/Code/test.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}