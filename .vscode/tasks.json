{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "${workspaceFolder}/Code/InterfaceFunction.c",
                "${workspaceFolder}/Code/Test.c",
                "-o",
                "${workspaceFolder}/test.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile C project"
        }
    ]
}